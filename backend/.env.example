# Environment Variables Template
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration (comma-separated list of allowed origins)
# Development: Leave commented to use defaults (http://localhost:5173, http://localhost:5174)
# Production: Set your frontend domains here
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# example: CORS_ORIGINS=https://yourblog.com,https://admin.yourblog.com

# Database Configuration
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/blog_api
